# Copy to `.env` and fill in. Only TOKEN_ADDRESS is required to go live.

# -----------------------------------------------------------------------------
# THE ONE THING YOU MUST SET AT LAUNCH
# -----------------------------------------------------------------------------
# The $WOLF (Land of Wolf) ERC-20 contract address.
#
# NOT SET YET — this value has not been provided. Leave it unset until the
# real contract exists and has been verified; do not guess or copy in a
# placeholder-looking address. Leaving it unset is deliberate and safe:
# /coin/stats returns nulls with placeholder: true, so the site shows dashes
# rather than advertising a token that isn't yours.
TOKEN_ADDRESS=0x8907ece9cbba1e2766263b3b5126ec65ab3ff77c

# -----------------------------------------------------------------------------
# UPSTREAMS — the defaults are correct for Robinhood Chain (id 4663)
# -----------------------------------------------------------------------------
RPC_URL=https://rpc.mainnet.chain.robinhood.com
BLOCKSCOUT_URL=https://robinhoodchain.blockscout.com
DEXSCREENER_URL=https://api.dexscreener.com

# -----------------------------------------------------------------------------
# SERVER
# -----------------------------------------------------------------------------
PORT=8787

# Interface to bind. Loopback by default: behind nginx there is no reason to
# accept traffic on the public interface. Set 0.0.0.0 only inside a container
# that is itself the network boundary.
HOST=127.0.0.1

# Comma-separated origins allowed to call this API. The frontend calls it
# cross-origin, so its URL must appear here.
# Use * to allow any origin (fine for public read-only data).
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# -----------------------------------------------------------------------------
# TUNING — sensible defaults, rarely worth changing
# -----------------------------------------------------------------------------
# How long a fetched payload is served before refetching.
CACHE_TTL_MS=30000

# How long the last good payload keeps being served while upstreams are failing.
# Past this, /coin/stats returns 503 and the panel shows its RETRY state.
STALE_MAX_MS=600000

# Per-request timeout for any single upstream call.
UPSTREAM_TIMEOUT_MS=8000

# How often the background refresher re-collects stats and writes them into
# the cache, so GET /coin/stats normally answers from memory instead of
# waiting on an upstream. Keep this below CACHE_TTL_MS so the timer stays
# ahead of expiry — the default (20s refresh vs 30s TTL) gives a 10s margin.
REFRESH_INTERVAL_MS=20000

# How long GET /coin/stats will wait on a cold cache (nothing collected yet,
# eg. right after a restart) before answering 503 instead of hanging. This is
# the ONLY wait budget this backend has — there is no swap/quote route to add
# a second one, and that second budget composing on top of this one is what
# caused the donor project's two production 504 outages (see src/config.js's
# waitBudgetWarning and deploy/nginx.conf). Kept well under both the ~8s
# worst-case collection time (every upstream call runs concurrently — see
# src/stats.js) and nginx's 15s proxy_read_timeout.
STATS_WAIT_MS=5000

# Where the once-a-day holders/burned snapshot is written (see src/snapshot.js
# — there is no upstream history for either figure, so this backend keeps its
# own). A relative path is resolved from the process's working directory,
# which is this project's root when started via `npm start` or PM2.
SNAPSHOT_PATH=./data/daily-snapshot.json
